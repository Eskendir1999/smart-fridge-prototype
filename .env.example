# Build and public-key server verification. Use a separate test project locally.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Optional public build settings.
VAPID_PUBLIC_KEY=
TELEGRAM_BOT_USERNAME=

# Server-only settings (never included in dist). Keep real values out of git.
GEMINI_API_KEY=
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
